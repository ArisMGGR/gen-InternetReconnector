# Real config holds the Wi-Fi password -- never commit it, under any name.
config.env
*.env

# Backups auto-setup.sh writes ("$CONFIG_FILE.bak") and hand-made copies
# (.old, .orig, .save, ...). Same password inside. The negation keeps the
# shipped template tracked and must come after the glob it overrides.
config.env.bak
*.env.bak
*.env.*
!*.env.example

# Daily logs and the run lock. Matched by name because RECONNECT_LOG_DIR can
# put them anywhere. logs/.gitkeep keeps the folder and matches neither rule.
*.log
.lock

# OS and editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Claude Code per-user files: local absolute paths, allowlists, personal notes.
.claude/settings.local.json
CLAUDE.local.md

# Working notes from the pre-open-source audit; not project documentation.
# tests/DECISIONS.md is deliberately NOT here -- docs and scripts cite it.
FINDINGS.md
LOG.md
VERIFY.md
